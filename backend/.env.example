# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Zero-setup local development (Node's built-in SQLite driver, tables created
# automatically on boot):
DATABASE_URL=sqlite:./data/ratings.db

# Production (Render Postgres). Tables are still created automatically; the
# Render internal connection URL does not use TLS, so leave DATABASE_SSL unset.
# DATABASE_URL=postgresql://user:password@host:5432/ratings
# Set to true only when connecting to Postgres over a public/external URL.
# DATABASE_SSL=true

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate a long random value in production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
# Milliseconds as a plain number (86400000 = 24 hours).
COOKIE_MAX_AGE=86400000

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Exact browser origin of the frontend. Only needed when the frontend calls the
# API directly; with the Vercel rewrite in vercel.json requests stay same-origin.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=10
# Set to "production" when deployed; enables the Secure flag on the auth cookie.
NODE_ENV=development
